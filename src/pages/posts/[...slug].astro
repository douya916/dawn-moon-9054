---
import { getPosts, readingTime, formatDate, categoryGradient } from '@/lib/blog';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import type { Post } from '@/lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.slug },
    props: {
      post,
      newer: (i > 0 ? posts[i - 1] : null) as Post | null,
      older: (i < posts.length - 1 ? posts[i + 1] : null) as Post | null,
    },
  }));
}

interface Props {
  post: Post;
  newer: Post | null;
  older: Post | null;
}

const { post, newer, older } = Astro.props;
const { Content } = await post.render();
const { title, description, category, tags, pubDate, author, updatedDate } = post.data;
const minutes = readingTime(post.body);
---

<BaseLayout title={title} description={description}>
  <Header />

  <main class="container-blog py-12">
    <article class="mx-auto max-w-3xl">
      <a href="/" class="text-sm text-slate-500 transition-colors hover:text-primary-600">← 返回首页</a>

      <div class="mt-6 flex flex-wrap items-center gap-3 text-sm text-slate-500">
        <span class={`chip bg-gradient-to-br ${categoryGradient(category)} text-white`}>{category}</span>
        <span>{formatDate(pubDate)}</span>
        <span>·</span>
        <span>{minutes} 分钟阅读</span>
        <span>·</span>
        <span>{author}</span>
      </div>

      <h1 class="mt-4 text-3xl font-bold leading-tight text-slate-900 dark:text-white sm:text-4xl">{title}</h1>
      <p class="mt-3 text-lg text-slate-500">{description}</p>

      <hr class="my-8 border-slate-200 dark:border-white/10" />

      <div class="prose prose-slate max-w-none prose-img:rounded-xl dark:prose-invert">
        <Content />
      </div>

      {
        tags.length > 0 && (
          <div class="mt-10 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <span class="chip bg-slate-100 text-slate-500 dark:bg-white/10 dark:text-slate-300">#{tag}</span>
            ))}
          </div>
        )
      }

      {
        updatedDate && (
          <p class="mt-6 text-sm text-slate-400">最后更新：{formatDate(updatedDate)}</p>
        )
      }

      <!-- 上一篇 / 下一篇 -->
      <nav class="mt-12 grid gap-4 border-t border-slate-200 pt-8 dark:border-white/10 sm:grid-cols-2">
        {
          newer ? (
            <a href={`/posts/${newer.slug}`} class="group rounded-xl border border-slate-200 p-4 transition-colors hover:border-primary-300 dark:border-white/10 dark:hover:border-primary-500/40">
              <span class="text-xs text-slate-400">← 上一篇</span>
              <span class="mt-1 block text-sm font-medium text-slate-800 transition-colors group-hover:text-primary-600 dark:text-slate-200 dark:group-hover:text-primary-400">
                {newer.data.title}
              </span>
            </a>
          ) : (
            <span />
          )
        }
        {
          older ? (
            <a href={`/posts/${older.slug}`} class="group rounded-xl border border-slate-200 p-4 text-right transition-colors hover:border-primary-300 dark:border-white/10 dark:hover:border-primary-500/40">
              <span class="text-xs text-slate-400">下一篇 →</span>
              <span class="mt-1 block text-sm font-medium text-slate-800 transition-colors group-hover:text-primary-600 dark:text-slate-200 dark:group-hover:text-primary-400">
                {older.data.title}
              </span>
            </a>
          ) : (
            <span />
          )
        }
      </nav>
    </article>
  </main>

  <Footer />
</BaseLayout>
