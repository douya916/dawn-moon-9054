---
import DocsLayout from '@/layouts/DocsLayout.astro';
import { getDocs } from '@/lib/blog';

const docs = await getDocs();
---

<DocsLayout title="文档中心" description="瓜奇（WordPress Headless CMS 前端构建器）从零到上线的完整搭建教程。">
  <div class="prose prose-slate max-w-none dark:prose-invert">
    <h1>瓜奇搭建教程</h1>
    <p>
      这是一套从<strong>软件准备</strong>到<strong>本地测试与构建器</strong>的完整实战教程，共 {docs.length} 章。
      教程以视频为准、文档为辅，按章节顺序阅读即可一步步把瓜奇（WordPress Headless CMS 前端构建器）跑起来。
    </p>
  </div>

  <div class="mt-8 grid gap-4 sm:grid-cols-2">
    {
      docs.map((doc) => (
        <a
          href={`/docs/${doc.slug}`}
          class="card card-hover group flex flex-col p-5"
        >
          <div class="flex items-center gap-3">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-gradient-to-br from-primary-500 to-violet-500 text-sm font-bold text-white">
              {doc.data.order}
            </span>
            <span class="font-semibold text-slate-900 transition-colors group-hover:text-primary-600 dark:text-white dark:group-hover:text-primary-400">
              {doc.data.title}
            </span>
          </div>
          <p class="mt-3 text-sm leading-relaxed text-slate-500">{doc.data.description}</p>
        </a>
      ))
    }
  </div>
</DocsLayout>
