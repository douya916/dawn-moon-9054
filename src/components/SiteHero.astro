---
import { SITE } from '@/lib/blog';

// diy: 备案期间移除 B 站 / 邮箱等外部联系方式入口（原 socials 数组已删除）

const bio =
  '热衷于子主题与网站美化的折腾党。比起从零造轮子，更享受在成熟主题上反复打磨视觉细节，把平淡的页面改造成自己喜欢的样子。这里记录我在折腾网站、美化界面路上的心得与分享。';
---

<section class="relative overflow-hidden border-b border-slate-200/60 bg-gradient-to-br from-primary-50 via-white to-violet-50 dark:border-white/10 dark:from-gray-900 dark:via-gray-950 dark:to-gray-900">
  <!-- 背景装饰 -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden">
    <div class="absolute -right-24 -top-24 h-72 w-72 rounded-full bg-gradient-to-br from-primary-200 to-violet-200 opacity-50 blur-3xl dark:from-primary-900/40 dark:to-violet-900/40"></div>
    <div class="absolute -bottom-24 -left-24 h-72 w-72 rounded-full bg-gradient-to-br from-emerald-200 to-teal-200 opacity-50 blur-3xl dark:from-emerald-900/30 dark:to-teal-900/30"></div>
  </div>

  <div class="container-blog relative py-20 sm:py-28">
    <div class="flex flex-col items-center gap-8 text-center md:flex-row md:items-start md:text-left">
      <!-- 头像 -->
      <div class="shrink-0">
        <img
          src="/touxiang.png"
          alt={SITE.author}
          class="h-28 w-28 rounded-3xl object-cover shadow-lg ring-4 ring-white dark:ring-gray-900 sm:h-32 sm:w-32"
          width="128"
          height="128"
          loading="eager"
          decoding="async"
        />
      </div>

      <div class="flex-1">
        <h1 class="text-3xl font-bold text-slate-900 dark:text-white sm:text-4xl lg:text-5xl">
          你好，我是 <span class="gradient-text">{SITE.author}</span>
        </h1>
        <p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-slate-600 dark:text-slate-300 sm:text-lg md:mx-0">
          {bio}
        </p>

        <div class="mt-8 flex flex-col items-center gap-4 sm:flex-row md:justify-start">
          <a href="/#articles" class="btn-primary px-6 py-3 text-base">阅读最新文章</a>
          <a href="/about" class="btn-ghost px-6 py-3 text-base">了解更多关于我</a>
        </div>

      </div>
    </div>
  </div>
</section>
