---
import { SITE } from '@/lib/blog';

interface Social {
  name: string;
  href: string;
  path: string;
}

const socials: Social[] = [
  {
    name: '哔哩哔哩',
    href: 'https://space.bilibili.com/3493146396724152',
    path: 'M17.813 4.653h.854c1.51.054 2.769.578 3.773 1.574 1.004.995 1.524 2.249 1.56 3.76v7.36c-.036 1.51-.556 2.769-1.56 3.773s-2.262 1.524-3.773 1.56H5.333c-1.51-.036-2.769-.556-3.773-1.56S.036 18.858 0 17.347v-7.36c.036-1.511.556-2.765 1.56-3.76 1.004-.996 2.262-1.52 3.773-1.574h.774l-1.174-1.12a1.234 1.234 0 0 1-.373-.906c0-.356.124-.658.373-.907l.027-.027c.267-.249.573-.373.92-.373.347 0 .653.124.92.373L9.653 4.44c.071.071.134.142.187.213h4.267a.836.836 0 0 1 .16-.213l2.853-2.747c.267-.249.573-.373.92-.373.347 0 .662.151.929.4.267.249.391.551.391.907 0 .355-.124.657-.373.906zM5.333 7.24c-.746.018-1.373.276-1.88.773-.506.498-.769 1.13-.786 1.894v7.52c.017.764.28 1.395.786 1.893.507.498 1.134.756 1.88.773h13.334c.746-.017 1.373-.275 1.88-.773.506-.498.769-1.129.786-1.893v-7.52c-.017-.765-.28-1.396-.786-1.894-.507-.497-1.134-.755-1.88-.773zM8 11.107c.373 0 .684.124.933.373.25.249.383.569.4.96v1.173c-.017.391-.15.711-.4.96-.249.249-.56.373-.933.373-.373 0-.684-.124-.933-.373-.25-.249-.383-.569-.4-.96V12.44c0-.391.142-.711.426-.96.285-.249.596-.373.907-.373zm8 0c.373 0 .684.124.933.373.25.249.383.569.4.96v1.173c-.017.391-.15.711-.4.96-.249.249-.56.373-.933.373-.373 0-.684-.124-.933-.373-.25-.249-.383-.569-.4-.96V12.44c0-.391.142-.711.426-.96.285-.249.596-.373.907-.373z',
  },
  {
    name: '邮箱',
    href: 'mailto:bber_cn@qq.com',
    path: 'M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z',
  },
];

const bio =
  '热衷于子主题与网站美化的折腾党。比起从零造轮子，更享受在成熟主题上反复打磨视觉细节，把平淡的页面改造成自己喜欢的样子。这里记录我在折腾网站、美化界面路上的心得与分享。';
---

<section class="relative overflow-hidden border-b border-slate-200/60 bg-gradient-to-br from-primary-50 via-white to-violet-50 dark:border-white/10 dark:from-gray-900 dark:via-gray-950 dark:to-gray-900">
  <!-- 背景装饰 -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden">
    <div class="absolute -right-24 -top-24 h-72 w-72 rounded-full bg-gradient-to-br from-primary-200 to-violet-200 opacity-50 blur-3xl dark:from-primary-900/40 dark:to-violet-900/40"></div>
    <div class="absolute -bottom-24 -left-24 h-72 w-72 rounded-full bg-gradient-to-br from-emerald-200 to-teal-200 opacity-50 blur-3xl dark:from-emerald-900/30 dark:to-teal-900/30"></div>
  </div>

  <div class="container-blog relative py-20 sm:py-28">
    <div class="flex flex-col items-center gap-8 text-center md:flex-row md:items-start md:text-left">
      <!-- 头像 -->
      <div class="shrink-0">
        <img
          src="/touxiang.png"
          alt={SITE.author}
          class="h-28 w-28 rounded-3xl object-cover shadow-lg ring-4 ring-white dark:ring-gray-900 sm:h-32 sm:w-32"
          width="128"
          height="128"
          loading="eager"
          decoding="async"
        />
      </div>

      <div class="flex-1">
        <h1 class="text-3xl font-bold text-slate-900 dark:text-white sm:text-4xl lg:text-5xl">
          你好，我是 <span class="gradient-text">{SITE.author}</span>
        </h1>
        <p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-slate-600 dark:text-slate-300 sm:text-lg md:mx-0">
          {bio}
        </p>

        <div class="mt-8 flex flex-col items-center gap-4 sm:flex-row md:justify-start">
          <a href="/#articles" class="btn-primary px-6 py-3 text-base">阅读最新文章</a>
          <a href="/about" class="btn-ghost px-6 py-3 text-base">了解更多关于我</a>
        </div>

        <div class="mt-8 flex items-center justify-center gap-3 md:justify-start">
          {
            socials.map((s) => (
              <a
                href={s.href}
                target={s.href.startsWith('http') ? '_blank' : undefined}
                rel="noopener"
                aria-label={s.name}
                class="flex h-10 w-10 items-center justify-center rounded-full bg-white text-slate-500 shadow-sm ring-1 ring-slate-200 transition-all duration-200 hover:-translate-y-0.5 hover:text-primary-600 dark:bg-white/5 dark:text-slate-300 dark:ring-white/10 dark:hover:text-primary-400"
              >
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d={s.path} />
                </svg>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
