---
import { categoryGradient, readingTime, formatDate, type Post } from '@/lib/blog';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, category, tags, pubDate } = post.data;
const gradient = categoryGradient(category);
const minutes = readingTime(post.body);
const coverText = title.slice(0, 1);
---

<article class="card card-hover group flex h-full flex-col overflow-hidden">
  <!-- 封面 -->
  <a href={`/posts/${post.slug}`} class="relative block h-40 overflow-hidden">
    <div class={`absolute inset-0 bg-gradient-to-br ${gradient}`}></div>
    <div class="absolute inset-0 opacity-20">
      <svg class="h-full w-full" viewBox="0 0 400 160" preserveAspectRatio="none">
        <circle cx="320" cy="30" r="80" fill="white" />
        <circle cx="60" cy="150" r="60" fill="white" />
      </svg>
    </div>
    <span class="absolute left-4 top-4 chip bg-white/25 text-white backdrop-blur-sm">{category}</span>
    <span class="absolute bottom-3 right-4 font-serif text-6xl font-black text-white/30">{coverText}</span>
  </a>

  <!-- 内容 -->
  <div class="flex flex-1 flex-col p-5">
    <h3 class="text-lg font-semibold leading-snug text-slate-900 transition-colors group-hover:text-primary-600 dark:text-white dark:group-hover:text-primary-400">
      <a href={`/posts/${post.slug}`}>{title}</a>
    </h3>
    <p class="mt-2 line-clamp-2 flex-1 text-sm leading-relaxed text-slate-500">{description}</p>

    <div class="mt-4 flex items-center justify-between text-xs text-slate-400">
      <span>{formatDate(pubDate)}</span>
      <span class="flex items-center gap-1">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        {minutes} 分钟阅读
      </span>
    </div>

    {
      tags.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-2">
          {tags.slice(0, 3).map((tag) => (
            <span class="chip bg-slate-100 text-slate-500 dark:bg-white/10 dark:text-slate-300">#{tag}</span>
          ))}
        </div>
      )
    }
  </div>
</article>
