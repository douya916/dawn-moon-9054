---
import { SITE, BEIAN, getCategories } from '@/lib/blog';

const currentYear = new Date().getFullYear();
const categories = await getCategories();

const navLinks = [
  { name: '首页', href: '/' },
  { name: '文章', href: '/#articles' },
  { name: '文档', href: '/docs' },
  { name: '友链', href: '/#friends' },
  { name: '关于', href: '/about' },
];

const socialLinks = [
  {
    name: '哔哩哔哩',
    href: 'https://space.bilibili.com/3493146396724152',
    path: 'M17.813 4.653h.854c1.51.054 2.769.578 3.773 1.574 1.004.995 1.524 2.249 1.56 3.76v7.36c-.036 1.51-.556 2.769-1.56 3.773s-2.262 1.524-3.773 1.56H5.333c-1.51-.036-2.769-.556-3.773-1.56S.036 18.858 0 17.347v-7.36c.036-1.511.556-2.765 1.56-3.76 1.004-.996 2.262-1.52 3.773-1.574h.774l-1.174-1.12a1.234 1.234 0 0 1-.373-.906c0-.356.124-.658.373-.907l.027-.027c.267-.249.573-.373.92-.373.347 0 .653.124.92.373L9.653 4.44c.071.071.134.142.187.213h4.267a.836.836 0 0 1 .16-.213l2.853-2.747c.267-.249.573-.373.92-.373.347 0 .662.151.929.4.267.249.391.551.391.907 0 .355-.124.657-.373.906zM5.333 7.24c-.746.018-1.373.276-1.88.773-.506.498-.769 1.13-.786 1.894v7.52c.017.764.28 1.395.786 1.893.507.498 1.134.756 1.88.773h13.334c.746-.017 1.373-.275 1.88-.773.506-.498.769-1.129.786-1.893v-7.52c-.017-.765-.28-1.396-.786-1.894-.507-.497-1.134-.755-1.88-.773zM8 11.107c.373 0 .684.124.933.373.25.249.383.569.4.96v1.173c-.017.391-.15.711-.4.96-.249.249-.56.373-.933.373-.373 0-.684-.124-.933-.373-.25-.249-.383-.569-.4-.96V12.44c0-.391.142-.711.426-.96.285-.249.596-.373.907-.373zm8 0c.373 0 .684.124.933.373.25.249.383.569.4.96v1.173c-.017.391-.15.711-.4.96-.249.249-.56.373-.933.373-.373 0-.684-.124-.933-.373-.25-.249-.383-.569-.4-.96V12.44c0-.391.142-.711.426-.96.285-.249.596-.373.907-.373z',
  },
  {
    name: '邮箱',
    href: 'mailto:bber_cn@qq.com',
    path: 'M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z',
  },
];
---

<footer class="mt-auto bg-slate-900 text-slate-300 dark:bg-black">
  <div class="container-blog py-12">
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-5">
      <!-- 品牌 -->
      <div class="lg:col-span-2">
        <a href="/" class="flex items-center space-x-2">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-primary-500 to-violet-500 text-sm font-bold text-white">
            {SITE.name.slice(0, 1)}
          </span>
          <span class="text-lg font-bold text-white">{SITE.name}</span>
        </a>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-slate-400">
          {SITE.description} 在这里记录技术、生活与思考，分享值得沉淀的内容。
        </p>
        <div class="mt-6 flex space-x-4">
          {
            socialLinks.map((s) => (
              <a
                href={s.href}
                target={s.href.startsWith('http') ? '_blank' : undefined}
                rel="noopener"
                class="text-slate-400 transition-colors duration-200 hover:text-white"
                aria-label={s.name}
              >
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d={s.path} />
                </svg>
              </a>
            ))
          }
        </div>
      </div>

      <!-- 导航 -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white">导航</h3>
        <ul class="mt-4 space-y-2">
          {
            navLinks.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-slate-400 transition-colors duration-200 hover:text-white">
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- 分类 -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white">分类</h3>
        <ul class="mt-4 space-y-2">
          {
            categories.map((cat) => (
              <li>
                <a
                  href={`/category/${encodeURIComponent(cat.name)}`}
                  class="text-sm text-slate-400 transition-colors duration-200 hover:text-white"
                >
                  {cat.name} <span class="text-slate-500">({cat.count})</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- 关于 -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white">关于</h3>
        <ul class="mt-4 space-y-2">
          <li><a href="/about" class="text-sm text-slate-400 transition-colors duration-200 hover:text-white">关于本站</a></li>
          <li><a href="/rss.xml" class="text-sm text-slate-400 transition-colors duration-200 hover:text-white">RSS 订阅</a></li>
          <li><a href="mailto:bber_cn@qq.com" class="text-sm text-slate-400 transition-colors duration-200 hover:text-white">联系我</a></li>
        </ul>
      </div>
    </div>

    <!-- 底部信息条 -->
    <div class="mt-12 border-t border-white/10 pt-8">
      <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
        <p class="text-sm text-slate-400">
          © {currentYear} {SITE.name}. 保留所有权利。
        </p>
        <div class="flex flex-col items-center gap-2 sm:flex-row sm:gap-6">
          <a
            href={BEIAN.url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm text-slate-400 transition-colors duration-200 hover:text-white"
          >
            {BEIAN.number}
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
