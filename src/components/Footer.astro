---
import { SITE, BEIAN, getCategories, DIY_SHOW_FRIEND_LINKS } from '@/lib/blog';

const currentYear = new Date().getFullYear();
const categories = await getCategories();

const navLinks = [
  { name: '首页', href: '/' },
  { name: '文章', href: '/#articles' },
  { name: '文档', href: '/docs' },
  // diy: 备案期间友链入口随友链区一起隐藏
  ...(DIY_SHOW_FRIEND_LINKS ? [{ name: '友链', href: '/#friends' }] : []),
  { name: '关于', href: '/about' },
];

// diy: 备案期间移除 B 站 / 邮箱等外部联系方式入口（原 socialLinks 数组 + 底部「联系我」链接已删除）
---

<footer class="mt-auto bg-slate-900 text-slate-300 dark:bg-black">
  <div class="container-blog py-12">
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-5">
      <!-- 品牌 -->
      <div class="lg:col-span-2">
        <a href="/" class="flex items-center space-x-2">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-primary-500 to-violet-500 text-sm font-bold text-white">
            {SITE.name.slice(0, 1)}
          </span>
          <span class="text-lg font-bold text-white">{SITE.name}</span>
        </a>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-slate-400">
          {SITE.description} 在这里记录技术、生活与思考，分享值得沉淀的内容。
        </p>
      </div>

      <!-- 导航 -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white">导航</h3>
        <ul class="mt-4 space-y-2">
          {
            navLinks.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-slate-400 transition-colors duration-200 hover:text-white">
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- 分类 -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white">分类</h3>
        <ul class="mt-4 space-y-2">
          {
            categories.map((cat) => (
              <li>
                <a
                  href={`/category/${encodeURIComponent(cat.name)}`}
                  class="text-sm text-slate-400 transition-colors duration-200 hover:text-white"
                >
                  {cat.name} <span class="text-slate-500">({cat.count})</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- 关于 -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white">关于</h3>
        <ul class="mt-4 space-y-2">
          <li><a href="/about" class="text-sm text-slate-400 transition-colors duration-200 hover:text-white">关于本站</a></li>
          <li><a href="/rss.xml" class="text-sm text-slate-400 transition-colors duration-200 hover:text-white">RSS 订阅</a></li>
        </ul>
      </div>
    </div>

    <!-- 底部信息条 -->
    <div class="mt-12 border-t border-white/10 pt-8">
      <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
        <p class="text-sm text-slate-400">
          © {currentYear} {SITE.name}. 保留所有权利。
        </p>
        <div class="flex flex-col items-center gap-2 sm:flex-row sm:gap-6">
          <a
            href={BEIAN.url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm text-slate-400 transition-colors duration-200 hover:text-white"
          >
            {BEIAN.number}
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
