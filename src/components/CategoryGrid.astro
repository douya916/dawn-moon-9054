---
import { categoryGradient, type CategoryCount } from '@/lib/blog';

interface Props {
  categories: CategoryCount[];
}

const { categories } = Astro.props;
---

<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
  {
    categories.map((cat) => (
      <a
        href={`/category/${encodeURIComponent(cat.name)}`}
        class="card card-hover group flex items-center gap-4 p-5"
      >
        <span class={`flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br ${categoryGradient(cat.name)} text-lg font-bold text-white shadow-sm`}>
          {cat.name.slice(0, 1)}
        </span>
        <span class="flex-1">
          <span class="block text-base font-semibold text-slate-900 transition-colors group-hover:text-primary-600 dark:text-white dark:group-hover:text-primary-400">
            {cat.name}
          </span>
          <span class="text-sm text-slate-500">{cat.count} 篇文章</span>
        </span>
      </a>
    ))
  }
</div>
